<div class="layout-nyt-chart"><div class="nc-headline">{{headline}}</div>{{#if subtitle}}<div class="nc-subtitle">{{subtitle}}</div>{{/if}}<div class="nc-chart-area"><div class="nc-bars">{{#each bars}}<div class="nc-bar-wrap" style="left:{{x}}px;width:{{../barW}}px"><div class="nc-bar-val" data-val="{{value}}">0</div><div class="nc-bar" style="--nc-pct:{{pct}}%"></div><div class="nc-bar-xlabel">{{label}}</div></div>{{/each}}</div>{{#if linePolyline}}<svg class="nc-line-svg" viewBox="0 0 1080 400" preserveAspectRatio="none"><polyline class="nc-polyline" points="{{linePolyline}}" fill="none" stroke-width="3" stroke-dasharray="{{lineLength}}" stroke-dashoffset="{{lineLength}}"/>{{#each dots}}<circle class="nc-dot nc-dot-{{@index}}" cx="{{x}}" cy="{{y}}" r="6" opacity="0"/>{{/each}}</svg>{{/if}}<div class="nc-baseline"></div></div>{{#if source}}<div class="nc-source">{{source}}</div>{{/if}}</div>
