<div class="bf-frame bf-ledger"><div class="bf-kicker">CATALOGUE / DATA</div><h2 class="bf-title">{{headline}}</h2>{{#if subtitle}}<p class="bf-lede">{{subtitle}}</p>{{/if}}<div class="bf-chart">{{#each bars}}<div class="bf-bar-wrap" style="left:{{x}}px;width:{{../barW}}px"><span class="bf-mono">{{value}}</span><div class="bf-bar" style="height:{{pct}}%"></div><span class="bf-mono">{{label}}</span></div>{{/each}}</div>{{#if source}}<div class="bf-source">{{source}}</div>{{/if}}<div class="bf-pagenum">—</div></div>