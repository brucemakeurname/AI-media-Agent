<div class="layout-conversation"><div class="cv-container">{{#each messages}}<div class="cv-bubble cv-bubble-{{side}} cv-bubble-{{@index}}{{#if isKey}} cv-bubble-key{{/if}}"><div class="cv-text">{{text}}</div>{{#if isKey}}<svg class="cv-underline-svg" viewBox="0 0 300 8"><line class="cv-underline-line" x1="0" y1="4" x2="300" y2="4" stroke-width="3" stroke-dasharray="300" stroke-dashoffset="300"/></svg>{{/if}}</div>{{/each}}<div class="cv-typing"><div class="cv-dot"></div><div class="cv-dot"></div><div class="cv-dot"></div></div></div>{{#if annotation}}<div class="cv-annotation">{{annotation}}</div>{{/if}}</div>
