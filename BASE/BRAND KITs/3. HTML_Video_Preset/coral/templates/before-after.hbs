<div class="layout-before-after"><div class="ba-left"><div class="ba-header ba-header-before">{{beforeLabel}}</div><div class="ba-items">{{#each beforeItems}}<div class="ba-item ba-item-tier-{{tier}}">{{text}}</div>{{/each}}</div></div><svg class="ba-divider-svg" viewBox="0 0 8 800" preserveAspectRatio="none"><line class="ba-divider-line" x1="4" y1="0" x2="4" y2="800" stroke-width="3" stroke-dasharray="800" stroke-dashoffset="800"/></svg><div class="ba-right"><div class="ba-header ba-header-after">{{afterLabel}}</div><div class="ba-items">{{#each afterItems}}<div class="ba-item ba-item-tier-{{tier}}">{{text}}</div>{{/each}}</div><div class="ba-highlight-border"></div></div>{{#if metric}}<div class="ba-metric">{{metric}}</div>{{/if}}</div>
