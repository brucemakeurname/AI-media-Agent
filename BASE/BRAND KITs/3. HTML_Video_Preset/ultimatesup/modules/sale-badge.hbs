<div class="bf-frame us-sale-badge" data-module="sale-badge">
  {{#if brandLogoUrl}}<div class="us-brand-strip"><img src="{{brandLogoUrl}}" alt="Ultimate Sup"/></div>{{/if}}
  {{#if metricValue}}<div class="us-metric-chip"><svg class="us-icon-lucide us-icon-chart" xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg><span class="us-metric-value">{{metricValue}}</span></div>{{/if}}
  <div class="us-info-box{{#if centered}} is-centered{{/if}}"><div class="us-info-meta"><span><svg class="us-icon-lucide us-icon-bookmark" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>{{#if bookmarkCount}}<strong>{{bookmarkCount}}</strong>{{/if}}</span>{{#if uiDate}}<span>{{uiDate}}</span>{{/if}}</div><div class="us-info-body us-offer-body"><div class="us-offer-badge">{{badgeText}}</div><div class="us-offer-copy"><span class="us-text-regular">{{offerText}}</span>{{#if qualifier}}<br/><span class="us-text-emphasis">{{qualifier}}</span>{{/if}}</div></div>{{#if cta}}<div class="us-info-footer"><span>EXACT TICKET COPY</span><strong>{{cta}}</strong></div>{{/if}}</div>
  {{#if viewCount}}<div class="us-engagement"><svg class="us-icon-lucide us-icon-play" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3"/></svg><span>{{viewCount}}</span></div>{{/if}}
</div>
