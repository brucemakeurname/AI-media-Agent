<div class="us-info-box">
  <div class="us-info-body us-offer-body">
    <div class="us-offer-badge">{{badgeText}}</div>
    <div class="us-offer-copy"><span class="us-text-regular">{{offerText}}</span>{{#if qualifier}}<br/><span class="us-text-emphasis">{{qualifier}}</span>{{/if}}</div>
  </div>
  {{#if cta}}<div class="us-info-footer"><span>EXACT TICKET COPY</span><strong>{{cta}}</strong></div>{{/if}}
</div>
