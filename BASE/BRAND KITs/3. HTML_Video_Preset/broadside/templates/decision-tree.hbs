<div class="layout-decision-tree"><svg class="dt-svg" viewBox="0 0 1080 1920" preserveAspectRatio="none">{{#each connectors}}<path id="dt-{{id}}" class="dt-connector" d="{{d}}" fill="none" stroke-width="3" stroke-dasharray="500" stroke-dashoffset="500"/>{{/each}}</svg><div class="dt-node dt-root" style="left:{{root.x}}px;top:{{root.y}}px">{{question}}</div><div class="dt-node dt-branch dt-branch-l" style="left:{{branches.left.x}}px;top:{{branches.left.y}}px">{{leftBranch}}</div><div class="dt-node dt-branch dt-branch-r" style="left:{{branches.right.x}}px;top:{{branches.right.y}}px">{{rightBranch}}</div>{{#each leaves}}<div class="dt-node dt-leaf dt-leaf-{{@index}}" style="left:{{x}}px;top:1080px">{{text}}</div>{{/each}}{{#if resolution}}<div class="dt-resolution">{{resolution}}</div>{{/if}}</div>
